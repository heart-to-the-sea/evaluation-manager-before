APP_ENV=dev
NUXT_PUBLIC_APP_NAME=评价管理系统-开发环境
NUXT_PUBLIC_API_BASE=/em
NUXT_DEVTOOLS=true

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

FRONTEND_DEPLOY_ROOT=/opt/evaluation-manager/frontend-dev
FRONTEND_STATIC_DIR=/opt/evaluation-manager/frontend-dev/current
FRONTEND_PID_DIR=/opt/evaluation-manager/frontend-dev/run
FRONTEND_LOG_DIR=/opt/evaluation-manager/frontend-dev/logs
FRONTEND_PACKAGE_DIR=/opt/evaluation-manager/frontend-dev/packages

NGINX_CONF_TARGET=/etc/nginx/conf.d/evaluation-manager-dev.conf
NGINX_SERVER_NAME=_
NGINX_LISTEN_PORT=8080
BACKEND_PROXY_HOST=127.0.0.1
BACKEND_PROXY_PORT=9990
