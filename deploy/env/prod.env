APP_ENV=prod
NUXT_PUBLIC_APP_NAME=评价管理系统
NUXT_PUBLIC_API_BASE=/em
NUXT_DEVTOOLS=false

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

FRONTEND_DEPLOY_ROOT=/opt/evaluation-manager/frontend
FRONTEND_STATIC_DIR=/opt/evaluation-manager/frontend/current
FRONTEND_PID_DIR=/opt/evaluation-manager/frontend/run
FRONTEND_LOG_DIR=/opt/evaluation-manager/frontend/logs
FRONTEND_PACKAGE_DIR=/opt/evaluation-manager/frontend/packages

NGINX_CONF_TARGET=/etc/nginx/conf.d/evaluation-manager.conf
NGINX_SERVER_NAME=_
NGINX_LISTEN_PORT=80
BACKEND_PROXY_HOST=127.0.0.1
BACKEND_PROXY_PORT=9990
